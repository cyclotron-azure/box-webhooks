# Box API Credentials
# Copy this file to .env and fill in your values

# Required: Your Box application Client ID
BOX_CLIENT_ID=your_client_id_here

# Required: Your Box application Client Secret
BOX_CLIENT_SECRET=your_client_secret_here

# Optional: Your Box Enterprise ID (only for CCG/JWT - leave empty for personal accounts)
BOX_ENTERPRISE_ID=your_enterprise_id_here

# Optional: OAuth 2.0 Redirect URI (default: http://localhost:8080/callback)
BOX_REDIRECT_URI=http://localhost:8080/callback
